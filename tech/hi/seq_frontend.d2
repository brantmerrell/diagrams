vars: @"../vars/jbm.d2"
classes: @"../../classes"
classes: @"../../tags"

layers: {
  0_auth: {
    _quality: {class: compiles}

    shape: sequence_diagram
    browser: {class: user}
    AuthProvider: {label: "context\nAuthContext\nAuthProvider"; class: frontend}
    Reader: {label: "Reader.tsx\n/"; class: frontend}
    Auth: {label: "Auth.tsx\n/auth"; class: frontend}
    api: {label: FastAPI; class: api}
    browser -> Reader: click "Sign in" {class: user}
    Auth.note1: |md
      render email form
    | {
      class: frontend
    }
    browser -> Auth: submit email address {class: user}
    Auth -> api: "POST /api/auth/request\n{email}" {class: frontend}
    api.note1: |md
      sends magic-link email
    | {
      class: api
    }
    browser -> Auth: "/auth?token=…" {class: user}
    Auth -> api: "GET /api/auth/verify?token=…\n(credentials: include)" {class: frontend} # TODO: verbs are edges, endpoints are nodes
    Auth -> api: "GET /api/auth/me\n(credentials: include)" {class: frontend} # TODO: verbs are edges, endpoints are nodes
    Auth -> AuthProvider: setUser(user) {class: frontend}
    Auth -> browser: navigate / {class: frontend}
    Reader -> api: "POST /api/auth/logout\n(credentials: include)" {class: frontend} # TODO: verbs are edges, endpoints are nodes
    Reader -> AuthProvider: setUser(null) {class: frontend}
  }
  1_load: {
    _quality: {class: compiles}

    shape: sequence_diagram
    browser: {class: user}
    main_tsx: {label: main.tsx; class: frontend}
    App: {label: App.tsx; class: frontend}
    AuthProvider: {label: "context\nAuthContext\nAuthProvider"; class: frontend}
    Reader: {label: "Reader.tsx\n/"; class: frontend}
    api: {label: FastAPI; class: api}
    browser -> main_tsx: load page {class: user}
    main_tsx -> App {class: frontend}
    App -> AuthProvider: mount {class: frontend}
    AuthProvider -> api: "GET /api/auth/me\n(credentials: include)" {class: frontend} # TODO: verbs are edges, endpoints are nodes
    App -> Reader: "route /" {class: frontend}
    Reader -> api: GET /api/stories {class: frontend} # TODO: verbs are edges, endpoints are nodes
    Reader -> api: "GET /api/stories/{id}/sentences?limit=500" {class: frontend} # TODO: verbs are edges, endpoints are nodes
    Reader.note1: |md
      render:
      * SentenceView
      * WordGloss
      * AudioPlayer
      * Navigation
    | {
      class: frontend
    }
  }
}
