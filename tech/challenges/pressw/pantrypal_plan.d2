vars: @"../../vars/jbm.d2"
classes: @"../../../classes"
classes: @"../../../tags"
classes: {
  chip_pm: {shape: square; width: 30; height: 30; style: {fill: "#4C6EF5"}}
  chip_ceo: {shape: square; width: 30; height: 30; style: {fill: "#F76707"}}
  chip_cx: {shape: square; width: 30; height: 30; style: {fill: "#37B24D"}}
  chip_legal: {shape: square; width: 30; height: 30; style: {fill: "#F03E3E"}}
  chip_baseline: {shape: square; width: 30; height: 30; style: {fill: "#868E96"}}
}

layers: {
  0_base: {
    _quality: {class: compiles}

    description: |md
      ## PantryPal take-home: plan of completion
      The real assessment (`pantrypal-assessment/`): build v1 of an AI\
      cooking assistant against four intentionally-contradictory\
      stakeholder artifacts, in a self-timeboxed 3 hours.

      This documents the brief itself (stakeholder asks + the\
      contradictions between them) and a plan for using the time box:\
      what's in scope, what's explicitly cut, and roughly how the\
      3 hours get spent.

      Source: `~/Documents/Professional/Challenges/PressW/pantrypal-assessment/`
    | {
      class: obj_service
    }
    links: {
      grid-columns: 1
      facade-pattern: {
        label: "design-patterns / facade.d2"
        link: ../../design-patterns/facade.d2
        class: _link
      }
      adapter-pattern: {
        label: "design-patterns / adapter.d2"
        link: ../../design-patterns/adapter.d2
        class: _link
      }
      chain-of-responsibility-pattern: {
        label: "design-patterns / chain-of-responsibility.d2"
        link: ../../design-patterns/chain-of-responsibility.d2
        class: _link
      }
    }
  }

  1_facade_pattern: {
    ...@"../../design-patterns/facade".layers.1_pattern

    client.label: "api_chat\nPOST /chat"

    facade.label: "agent_loop\n(tool-calling loop)"
    facade.start.label: "invoke"

    cpu.label: "llm_provider\n(via AI SDK)"
    cpu.freeze.label: "reason / generate"
    cpu.execute.label: "loads lane_guardrail"

    memory.label: "tool_search\n(Tavily)"
    memory.load.label: "tool call"

    hd.label: "tool_equipment"
    hd.read.label: "tool call"
  }

  2_adapter_pattern: {
    ...@"../../design-patterns/adapter".layers.1_pattern

    client.label: "chat_ui\n(voice_ui future)"

    target.label: "channel_adapter"
    target.request.label: "normalized message"

    adapter.label: "channel_adapter"
    adapter.request.label: "normalized message"

    adaptee.label: "api_chat\n(POST /chat)"
    adaptee.specificRequest.label: "backend request shape"
  }

  3_architecture: {
    direction: down
    # _quality: {class: compiles}

    legend: {
      label: "priority key"
      direction: right
      pm: {grid-columns: 2; chip: {class: chip_pm; label: ""}; who: {shape: text; label: "Priya"}}
      ceo: {grid-columns: 2; chip: {class: chip_ceo; label: ""}; who: {shape: text; label: "Marcus"}}
      cx: {grid-columns: 2; chip: {class: chip_cx; label: ""}; who: {shape: text; label: "Jordan"}}
      legal: {grid-columns: 2; chip: {class: chip_legal; label: ""}; who: {shape: text; label: "Diane"}}
      baseline: {grid-columns: 2; chip: {class: chip_baseline; label: ""}; who: {shape: text; label: "baseline"}}
    }

    client: {
      label: "client"
      chat_ui: {class: [obj_client; to_add]; label: "chat frontend\n(text channel)"; c1: {class: chip_baseline; label: ""}}
      voice_ui: {
        class: [obj_client; future]
        label: "voice channel\n(future)"
        grid-columns: 2
        c1: {class: chip_ceo; label: ""}
        c2: {class: chip_cx; label: ""}
      }
    }

    channel_adapter: {
      class: [obj_service; to_add]
      label: "channel adapter"
      note: {shape: text; label: "build now: normalizes input/output so\nvoice can plug in later without touching\nthe core. No voice implementation yet."}
      c1: {class: chip_ceo; label: ""}
    }

    api_chat: {class: [obj_server; to_add]; label: "POST /chat\n(AI SDK route)"; c1: {class: chip_baseline; label: ""}}

    core: {
      label: "agent core"
      agent_loop: {class: [ai_assistant; to_add]; label: "tool-calling loop\n(generateText/streamText)"; c1: {class: chip_baseline; label: ""}}
      lane_guardrail: {class: [obj_service; to_add]; label: "system prompt:\ncooking-lane guardrail"; c1: {class: chip_ceo; label: ""}}
      personality: {
        class: [obj_service; future]
        label: "system prompt:\nopinionated personality"
        grid-columns: 2
        c1: {class: chip_ceo; label: ""}
        c2: {class: chip_cx; label: ""}
      }
      conversation_context: {class: to_add; label: "conversation context\n(in-request messages,\nno DB)"; c1: {class: chip_baseline; label: ""}}
    }

    tools: {
      label: "tools (model-invoked)"
      tool_search: {class: [obj_service; to_add]; label: "web search\n(Tavily)"; c1: {class: chip_baseline; label: ""}}
      tool_equipment: {
        class: [obj_service; to_add]
        label: "equipment/pantry\ncheck"
        grid-columns: 2
        c1: {class: chip_pm; label: ""}
        c2: {class: chip_cx; label: ""}
      }
      tool_router: {class: [obj_service; future]; label: "model router\n(cheap vs smart)"; c1: {class: chip_pm; label: ""}}
    }

    guardrails: {
      label: "response pipeline"
      allergen_mw: {
        class: [obj_service; to_add]
        label: "allergen disclosure\ninjector"
        note: {shape: text; label: "v1: unconditional visible warning on\nevery recipe/ingredient response — not\nyet conditional on detected allergens"}
        c1: {class: chip_legal; label: ""}
      }
      health_note: {
        class: [obj_service; to_add]
        label: "health-mention\ndisclaimer"
        note: {shape: text; label: "not a route/UI redirect — phrasing the\nagent includes in its own reply: acknowledge\ngenerically, suggest a professional. No\ntoast or UI element needed."}
        c1: {class: chip_legal; label: ""}
      }
    }

    state: {
      label: "state"
      profile_store: {
        class: [obj_db; to_add]
        label: "durable user profile"
        note: {shape: text; label: "schema/DB now; stores stated\npreferences only (\"vegetarian\" — legal-\nsafe). Health-condition fields stay out\nuntil Diane signs off on retention."}
        grid-columns: 2
        c1: {class: chip_ceo; label: ""}
        c2: {class: chip_cx; label: ""}
      }
      favorites_store: {class: [obj_db; future]; label: "favorites"; c1: {class: chip_cx; label: ""}}
      recipe_kb: {class: [obj_db; future]; label: "recipe knowledge base\n(from PDF import)"; c1: {class: chip_cx; label: ""}}
    }

    external: {
      label: "external"
      llm_provider: {class: [ai_assistant; to_add]; label: "LLM provider\n(via AI SDK)"; c1: {class: chip_baseline; label: ""}}
      tavily_api: {class: [obj_service; to_add]; label: "Tavily API"; c1: {class: chip_baseline; label: ""}}
      pdf_ingest: {class: [obj_service; future]; label: "PDF recipe\ningestion"; c1: {class: chip_cx; label: ""}}
      grocery_export: {class: [obj_service; future]; label: "grocery-list\nexport"; c1: {class: chip_cx; label: ""}}
    }

    docker_compose: {class: [obj_service; to_add]; label: "docker-compose.yml"; c1: {class: chip_baseline; label: ""}}

    client.chat_ui -> channel_adapter: {class: edge_request; label: message}
    client.voice_ui -> channel_adapter: {class: [edge_request; future]; label: "message\n(future)"}
    channel_adapter -> api_chat: {class: edge_request}
    api_chat -> core.agent_loop: {class: edge_write; label: invoke}
    core.agent_loop -> core.lane_guardrail: {class: edge_query; label: loads}
    core.agent_loop -> core.personality: {class: [edge_query; future]; label: "loads\n(future)"}
    core.agent_loop -> core.conversation_context: {class: edge_write; label: "reads/writes\nturn history"}
    core.agent_loop -> external.llm_provider: {class: edge_request; label: "reason / generate"}
    core.agent_loop -> tools.tool_search: {class: edge_query; label: "tool call\n(model-decided)"}
    core.agent_loop -> tools.tool_equipment: {class: edge_query; label: "tool call\n(model-decided)"}
    core.agent_loop -> tools.tool_router: {class: [edge_query; future]; label: "tool call\n(future)"}
    tools.tool_search -> external.tavily_api: {class: edge_request}
    core.conversation_context <- tools.tool_equipment: {class: edge_query; label: "reads stated\nequipment"}
    core.conversation_context -> state.profile_store: {class: edge_write; label: "captures stated\npreferences (non-health)"}
    core.agent_loop -> guardrails.allergen_mw: {class: edge_write; label: response}
    guardrails.allergen_mw -> guardrails.health_note: {class: edge_write}
    api_chat <- guardrails.health_note: {class: edge_write; label: "final response"}
    api_chat -> channel_adapter: {class: edge_write}
    client.chat_ui <- channel_adapter: {class: edge_write}
    core.agent_loop -> state.favorites_store: {class: [edge_write; future]; label: "future: save\nliked recipe"}
    state.profile_store -> external.grocery_export: {class: [edge_query; future]; label: "future: meal\nhistory → list"}
    state.recipe_kb <- external.pdf_ingest: {
      class: [edge_write; future]
      label: future
    }
    core.agent_loop <- state.recipe_kb: {class: [edge_query; future]; label: "future: richer\nrecipe grounding"}
    docker_compose -> api_chat: {class: edge_spawn; label: up}
    docker_compose -> client.chat_ui: {class: edge_spawn; label: up}
  }

  4_chain_of_responsibility_pattern: {
    ...@"../../design-patterns/chain-of-responsibility".layers.1_pattern

    client.label: "agent_loop"

    handler1.label: "allergen_mw\n(disclosure injector)"
    handler1.handle.label: "inject allergen\ndisclosure"

    handler2.label: "health_note\n(disclaimer)"
    handler2.handle.label: "add health\ndisclaimer"
  }
}
