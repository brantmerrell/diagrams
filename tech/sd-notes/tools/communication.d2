vars: @"../../vars/system-design.d2"
classes: @"../../../classes"
classes: @"../../../tags"
layers: {
  **.style.text-transform: none
  0_base: {
    _quality: {class: compiles}
    design_pattern: {
      label: "design pattern: none"
      link: ../../design-patterns/none.d2
      class: _link
    }
  }
  1_http: {
    # TODO: zig-zag
    _quality: {class: compiles}
    client: {
      class: obj_client
      label: Web Client
    }
    server: {
      class: obj_server
      label: Web Server
    }
    request_flow: |md
    ## Request Flow
      * DNS Lookup
      * TCP Handshake
      * HTTP Request
      * Server Processing
      * HTTP Response
      * TCP Close
    |
    client -> server: {class: edge_request}
    client -- request_flow
  }
  2_websocket: {
    _quality: {class: styled}
    client: {
      class: obj_client
      label: WebSocket Client
    }
    server: {
      class: obj_server
      label: WebSocket Server
    }
    connection_upgrade: {
      handshake: HTTP Upgrade Handshake
      persistent_conn: Persistent Connection
      bidirectional: Bidirectional Messages
      handshake -> persistent_conn
      persistent_conn -> bidirectional
    }
    client <-> server: {class: edge_request; label: bidirectional}
    client -- connection_upgrade
  }
  3_grpc: {
    _quality: {class: styled}
    client_service: {
      class: obj_server
      label: Client Service
    }
    server_service: {
      class: obj_server
      label: Server Service
    }
    protobuf_layer: {
      label: Protocol Buffers
      shape: hexagon
    }
    http2_layer: {
      label: HTTP/2 + TLS
      shape: hexagon
    }
    client_service -> protobuf_layer: serialize {class: edge}
    protobuf_layer -> http2_layer: transport {class: edge}
    http2_layer -> server_service: {class: edge_request}
    server_service -> http2_layer
    http2_layer -> protobuf_layer: transport
    protobuf_layer -> client_service: deserialize
  }
}
