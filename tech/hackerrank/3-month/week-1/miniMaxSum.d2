direction: down
vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../../tags"

_quality: {class: compiles}

classes {
  highlight {
    style {
      stroke: crimson
      fill: steelblue
    }
  }
}
input: input arr
miniMaxSum: miniMaxSum {
  sort: arr.sort
  split: split {
    lower: |md
    ## lower
    excludes last elem:  
    ```python
    arr[:(N-1)]
    ```
    |
    upper: |md
    ## upper
    excludes first elem:
    ```python
    arr[1:]
    ```
    |
  }
  sum: sum()
  str: str()
  join: "' '.join()"
  print: print()
  sort -> split
  split.lower -> sum
  split.upper -> sum
  sum -> str
  sum -> str
  str -> join
  str -> join
  join -> print
}
input -> miniMaxSum.sort

design_pattern: {
  label: "design pattern: none"
  link: ../../../design-patterns/none.d2
  class: _link
}
