direction: down
vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../classes/tags"
classes: @"../../../classes/function"

_quality: {class: compiles}

_input: input {
  n
  k
  ar
}
_def: def divisibleSumPairs {
  _res: {
    label: result \n init @ 0
    style: {
      font-size: 22
    }
  }
  _iter_i: iterate i {
    grid-rows: 1
    0: i=0 { class: iter_step }
    1: ... { class: iter_step }
    2: ... { class: iter_step }
    3: i=N { class: iter_step }
  }
  _iter_j: iterate j > i . {
    grid-rows: 1
    2: ... { class: iter_step }
    3: i=N { class: iter_step }
  }
  _condition: ar\[i\] + ar\[j\] % k == 0 {
    class: cond
  }
  _iter_j -> _condition
  _condition -> _res: increment
}
_input.n -> _def._iter_i: { class: scalar }
_def._iter_i -> _def._iter_j: n { class: scalar }
_input.ar -> _def._condition: { class: data }
_input.k -> _def._condition: { class: scalar }
