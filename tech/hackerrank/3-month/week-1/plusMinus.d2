direction: down
vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../../tags"

_quality: {class: compiles}

classes {
  highlight {
    style {
      stroke: crimson
      fill: steelblue
    }
  }
}
input
arr: arr
plusMinus: plusMinus {
  enumerate: {
    shape: diamond
    positive: {
      shape: oval
    }
    negative {
      shape: oval
    }
    equal {
      shape: oval
    }
  }
  counts: counts {
    0: 0
    1: 1
    2: 2
  }
  enumerate.positive -> counts.0
  enumerate.negative -> counts.1
  enumerate.equal -> counts.2
  counts.0 -> print
  counts.1 -> print
  counts.2 -> print
}
arr -> plusMinus.enumerate
