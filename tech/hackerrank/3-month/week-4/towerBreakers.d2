vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../../classes"
classes: @"../../../../tags"

_quality: {class: compiles}

towerBreakers {
  label: towerBreakers(n, m)
  AND: {
    label: AND
    class: cond
    condition_0: {
      label: isOne
      class: cond
    }
    condition_1: {
      label: isEven
      class: cond
    }
  }
  AND -> result: {
    label: player 1 wins
    class: negative
  }
  AND -> result: {
    label: player 2 wins
    class: positive
  }
}
