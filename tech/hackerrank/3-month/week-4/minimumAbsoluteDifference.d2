vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../../classes"
classes: @"../../../../tags"

_quality: {class: compiles}



minimumAbsoluteDifference: {
  label: minimumAbsoluteDifference(arr)
  sort: {
    class: op
  }
  result: {
    label: result\ninit arr\[1\]
  }
  iteration: {
    label: "for [i, i, i...] in range(len(arr)-1):"
    class: iter
  }
  diff: {
    class: op
    elem: current\nelement
    next_elem: next\nelement
  }
  sort -> iteration
  iteration -> diff
  diff -> result
}

design_pattern: {
  label: "design pattern: none"
  link: ../../../design-patterns/none.d2
  class: _link
}
