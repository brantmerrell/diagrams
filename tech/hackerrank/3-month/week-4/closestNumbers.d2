vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../../tags"
classes: @"../../../../classes"

_quality: {class: compiles}

closestNumbers {
  label: closestNumbers(arr)
  sort {
    label: sort()
  }
  sort -> iterate
  result {
    label: result\ninit \[arr\[:2\]\]
    example: |md
    ```python
    arr = sorted([4, 2, 1, 3, 5])
    # [1, 2, 3, 4, 5]
    arr[:2]
    # [1, 2]  (first pair, before scanning for closer pairs)
    ```
    |
  }
  smallest_diff: {
    label: smallest_diff\ninit arr\[1\]-arr\[0\]
  }
  iterate: {
    label: "for [i, i, i...] in range(len(arr)-1)"
    class: iter
  }
  current_diff: {
    label: current_diff\ninit arr\[i+1\]-arr\[i\]
  }
  iterate -> current_diff: init
  smallest_diff -> condition_1
  condition_1: {
    label: current_diff < smallest_diff
    class: cond
  }
  condition_2: {
    label: current_diff == smallest_diff
    class: cond
  }
  reset: {
    label: reset\n\[arr\[\i\], arr\[i+1\]\]\nsmallest_diff = current_diff
    class: op
  }
  append: {
    label: append\nelem & next elem
    class: op
  }
  result <- reset 
  smallest_diff <- reset
  reset <- condition_1: {
    class: positive
  }
  current_diff -> condition_1
  condition_1 -> condition_2: {
    class: negative
  }
  result <- append <- condition_2
}
closestNumbers -> closestNumbers.smallest_diff: init


design_pattern: {
  label: "design pattern: none"
  link: ../../../design-patterns/none.d2
  class: _link
}
