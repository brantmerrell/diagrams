vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../../classes"
classes: @"../../../../tags"

_quality: {class: compiles}

maxMin: {
  label: maxMin(k, arr)
  len: {
    label: len()
    class: op
  }
  n
  iterate: {
    label: "for [i, i, i...] in range(n-k+1)"
    class: iter
  }
  diff: {
    class: op
    label: diff\narr\[i+k-1\]-arr\[i\]
  }
  min: {
    class: op
    label: min()\nresult, diff
  }
  result: {
    label: result
  }
  len -> n
  n -> iterate
  iterate -> diff
  diff -> min
  min -> result
}
