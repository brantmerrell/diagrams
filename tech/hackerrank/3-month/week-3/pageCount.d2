direction: down
vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../../tags"

_quality: {class: compiles}

pageCount {
  label: pageCount(n, p)
  from_left: from left\np <= n / 2 {
    shape: diamond
    return: floor(left_dist / 2) {
      shape: oval
    }
  }
  from_right: from right\np > n / 2 {
    shape: diamond
    even: even\nceiling {
      shape: diamond
      style: {
        font-size: 20
      }
      return: ceil(right_dist / 2) {
        shape: oval
      }
    }
    odd: odd\nfloor {
      shape: diamond
      style: {
        font-size: 20
      }
      return: floor(right_dist / 2) {
        shape: oval
      }
    }
  }
  from_left -> from_right: {
    style: {
      stroke: darkred
    }
  }
}
pageCount.from_right.even.return -> return
pageCount.from_right.odd.return -> return
pageCount.from_left.return -> return: {
  style.stroke: darkgreen
}

design_pattern: {
  label: "design pattern: none"
  link: ../../../design-patterns/none.d2
  class: _link
}
