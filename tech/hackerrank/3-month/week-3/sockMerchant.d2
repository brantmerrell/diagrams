direction: down
vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../../tags"
classes: @"../../../../classes"

_quality: {class: compiles}

sockMerchant {
  label: sockMerchant(n, ar)
  result: result\ninit 0 {
    class: generic_node
  }
  iter: i in range(n) {
    class: iter
  }
  cond: elem in hash {
    class: cond
  }
  iter -> cond: {
    class: generic_edge
  }
  cond -> result: yes {
    class: positive
  }
  cond -> result: no {
    class: negative
  }
  # TODO: what's actually returned?
}

design_pattern: {
  label: "design pattern: none"
  link: ../../../design-patterns/none.d2
  class: _link
}
