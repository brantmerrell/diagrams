vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../../classes"
classes: @"../../../../tags"

_quality: {class: compiles}

grid: {
  label: grid
  notes: |md
  * instructions say square
  * test cases include rectangle
  | {
    class: highlight
  }
}
gridChallenge: {
  label: def gridChallenge(grid):
  class: op
  n: {
    label: n\ncolumns
    class: generic_node
  }
  m: {
    label: m\ncolumns
    class: generic_node
  }
  len_n: {
    class: op
    label: len(grid)
  }
  len_m: {
    class: op
    label: len(grid\[0\])
  }
  iterate_sort: {
    label: "for [i, i, i...] in range(n):"
    class: iter
  }
  sort_row: {
    label: sort row
    class: op
    readme: |md
    * sorts row
    * expands from string to list
    * downstream ops treat as list
    |
  }
  iterate_cols: {
    label: "for [col, col, col...] in range(m):"
    class: iter
  }
  then: {
    class: edge_down
  }
  column: {
    label: column\n init \[\]
    class: generic_node
  }
  iterate_rows: {
    label: "for [row, row, row...] in range(n):"
    class: iter
  }
  append: {
    label: .append()
    class: op
  }
  is_sorted: {
    label: is sorted
    class: cond
  }
  len_n -> n: {
    class: scalar
  }
  len_m -> m: {
    class: scalar
  }
  n -> iterate_sort: {
    class: scalar
  }
  m -> iterate_cols: {
    class: scalar
  }
  iterate_sort -> sort_row: {
    class: generic_edge
  }
  iterate_sort -> then: {
    class: generic_edge
  }
  then -> iterate_cols: {
    class: generic_edge
  }
  iterate_cols -> column: {
    class: generic_edge
  }
  iterate_cols -> iterate_rows: {
    class: generic_edge
  }
  iterate_rows -> append: {
    class: generic_edge
  }
  append -> column: {
    class: data
  }
  column -> is_sorted: {
    class: data
  }
  is_sorted -> result: YES {
    class: positive
  }
  is_sorted -> result: NO {
    class: negative
  }
}
grid -> gridChallenge.len_n: {
  class: data
}
grid -> gridChallenge.len_m: {
  class: data
}

design_pattern: {
  label: "design pattern: none"
  link: ../../../design-patterns/none.d2
  class: _link
}
