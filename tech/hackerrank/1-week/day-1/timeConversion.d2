vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../../classes"
classes: @"../../../../tags"

_quality: {class: compiles}


timeConversion: {
  label: timeConversion(s)
  split_colon: {
    label: .split(\":\")
    class: op
  }
  HH
  MM
  SS
  XM
  12AM: {
    label: 12AM
    class: cond
  }
  PM: {
    label: PM\nnot 12
    class: cond
  }
  splice_2: {
    label: splice @2\n\[:2\]\[2:\]
    example: |md
    ```python
    s = "07:05:45PM"
    s[:-2]   # "07:05:45"  (time)
    s[-2:]   # "PM"        (AM/PM marker)
    ```
    |
  }
  join_colon: {
    label: \":\".join()
    class: op
  }
  split_colon -> HH
  split_colon -> MM
  split_colon -> SS
  splice_2 -> XM
  SS <- splice_2
  SS -> splice_2
  XM -> PM
  HH -> PM
  HH <- PM: {
    label: +12
    class: positive
  }
  XM -> 12AM
  HH -> 12AM
  HH <- 12AM: {
    label: 00
    class: positive
  }
  HH -> join_colon
  MM -> join_colon
  SS -> join_colon
  join_colon -> result
}
