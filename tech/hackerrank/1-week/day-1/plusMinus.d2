vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../../classes"
classes: @"../../../../tags"

_quality: {class: compiles}

plusMinus: {
  label: def plusMinus(arr)
  iteration: {
    label: "for [a, a, a...] in arr"
    class: iter
  }
  condition_negative: {
    label: a < 0
    class: cond
  }
  condition_zero: {
    label: a == 0
    class: cond
  }
  condition_positive: {
    label: a > 0
    class: cond
  }
  result: {
    label: result\ninit \[0, 0, 0\]
  }
  print: {
    class: op
  }
  iteration -> condition_negative
  condition_negative -> result: {
    label: increment\n\nresult\[0\]
    class: positive
  }

  iteration -> condition_zero
  condition_zero -> result: {
    label: increment\n\nresult\[1\]
    class: positive
  }
  iteration -> condition_positive
  condition_positive -> result: {
    label: increment\n\nresult\[2\]
    class: positive
  }
  result -> print
}

design_pattern: {
  label: "design pattern: none"
  link: ../../../design-patterns/none.d2
  class: _link
}
