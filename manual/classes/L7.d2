**.style.text-transform: none
debug: {
  style: {
    font-size: 32
    stroke-width: 5
  }
}
notes: {
  shape: page
  style: {
    font-size: 30
  }
}
note: {
  shape: page
}
edge_invis: {
  style: {
    stroke-width: 0
  }
}
edge_request: {
  label: rq
  style: {
    font-size: 24
    stroke-dash: 5
    stroke-width: 3
  }
}
edge_write: {
  label: W
  style: {
    font-size: 24
    stroke-dash: 2
    stroke-width: 3
  }
}
edge_query: {
  label: Q
  style: {
    font-size: 24
    stroke-dash: 4
    stroke-width: 3
  }
}
obj_cache: {
  style: {
    font-size: 26
  }
}
objs_cache: {
  style: {
    font-size: 26
    multiple: true
  }
}
obj_cdn: {
  style: {
    font-size: 26
  }
}
obj_client: {
  shape: c4-person
  label: client
  style: {
    font-size: 26
  }
}
obj_db: {
  shape: cylinder
  style: {
    font-size: 26
  }
}
objs_db: {
  shape: cylinder
  style: {
    font-size: 26
    multiple: true
  }
}
obj_dns: {
  style: {
    font-size: 22
  }
}
obj_lb: {
  shape: hexagon
  icon: https://icons.terrastruct.com/gcp%2FProducts%20and%20services%2FNetworking%2FCloud%20Load%20Balancing.svg
  style: {
    font-size: 26
  }
}
objs_lb: {
  style: {
    multiple: true
    font-size: 26
  }
}
obj_server: {
  style: {
    font-size: 26
  }
}
objs_server: {
  style: {
    multiple: true
    font-size: 26
  }
}
obj_service: {
  style: {
    font-size: 26
  }
}
objs_service: {
  style: {
    font-size: 26
    multiple: true
  }
}
obj_queue: {
  shape: queue
  style: {
    font-size: 26
  }
}
ai_assistant: {
  style: {
    font-size: 24
  }
}
mcp_server: {
  style: {
    font-size: 22
  }
}
data_source: {
  style: {
    font-size: 18
  }
}
security_layer: {
  style: {
    font-size: 18
  }
}
