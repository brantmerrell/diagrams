vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../classes/function"
classes: @"../../../classes/tags"

_quality: {class: compiles}

lonelyinteger {
  label: lonelyinteger(a)
  tracker: {
    label: tracker\ninit \{\}
  }
  iterate: {
    label: "for [elem, elem, elem... ] in a"
    class: iter
  }
  condition: {
    label: elem in tracker
    class: cond
  }
  iterate -> condition
  tracker <- condition: {
    class: positive
    label: delete
  }
  tracker <- condition: {
    class: negative
    label: create
  }
  tracker -> return: last
}
