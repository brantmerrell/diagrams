vars: {
  d2-config: {
    theme-id: 201
    layout-engine: elk
  }
}

classes: @"../../../classes/tags"

_quality: {class: compiles}

twoArrays: {
  label: twoArrays(k, A, B)
  sort
  iter: i in range(len(A))
  cond: A\[i\] + B\[i\] < k {
    shape: diamond
  }
  iter -> cond
  sort -> cond: A
  sort_rev -> cond: B
  cond -> output
}
