direction: down
vars: {
  d2-config: {
    theme-id: 201
    layout-engine: elk
  }
}

classes: @"../../../classes/tags"

_quality: {class: compiles}

migratoryBirds {
  label: migratoryBirds(arr)
  type_freq: types\ninit\[0\] * 6
  iter: bird in birds # TODO: how is bird actually used?
  iter_freq: type,freq in types
  cond: freq == max(type_freq)
  iter -> type_freq: load
  type_freq -> iter_freq
  iter_freq -> cond
}
result
migratoryBirds.cond -> result
