direction: down
vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../classes/tags"
classes: @"../../../classes/function"

_quality: {class: compiles}

_def: def lonelyinteger(a) {
  _lookup: lookup
  _iter: enumerate(a)\nndx,elem {
  }
  _cond: elem in lookup.keys() {
    shape: diamond
    y: {
      style: {
        fill: mediumseagreen
        font-color: white
      }
    }
    n: {
      style: {
        fill: crimson
        font-color: white
      }
    }
  }
  _cond.y -> _lookup: create key\]placholder\] {
    class: positive
  }
  _cond.n -> _lookup: delete key {
    class: negative
  }
  _iter -> _cond
}
