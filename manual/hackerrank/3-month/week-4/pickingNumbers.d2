direction: down
vars: @"../../../vars/hackerrank.d2"
**.style.text-transform: none
classes: @"../../../classes/tags"
classes: @"../../../classes/function"

_quality: {class: compiles}

pickingNumbers {
  label: pickingNumbers(a)
  condition_1: {
    label: max(a) == min(a)
    class: cond
    y: {
      label: result = len(a)
      class: positive
    }
    n: {
      label: calculate
      class: negative
    }
  }
  iter_1: {
    class: iter
    label: left in range(len(a) - 1)
  }
  iter_2: {
    class: iter
    width: 400
    label: while a\[right\] - a\[left\] < 2 and right < len(a) - 1
  }
  right: {
    label: right\n init left+1
  }
  result: {
    label: result\n init 2
  }
  condition_1.y -> result: {
    class: positive
  }
  update: {
    label: max(result, right - left)
  }
  condition_1.n -> iter_1: a.sort
  iter_1 -> iter_2
  iter_1 -> right
  iter_2 -> right: increment
  right -> update
  update -> result
}
