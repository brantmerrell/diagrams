direction: down
vars: {
  d2-config: {
    theme-id: 201
    layout-engine: elk
  }
}

classes: @"../../../classes/tags"

_quality: {class: compiles}


kangaroo: {
  label: kangaroo(x1, v1, x2, v2)
  conditions: "" {
    class: cond
    description: |md
    ## vertical OR slope
    ### vertical
    * hop is down
    * v_2 >= v_1
    ### slope
    * diffs don\'t divide evenly
    * not (x2-x1) \% (v1 - v2) == 0
    |
  }
  conditions -> result: "YES" {
    style.stroke: darkred
  }
  conditions -> result: "NO" {
    style.stroke: darkgreen
  }
}
classes: {
  cond: {
    shape: diamond
  }
}
