  label: 𐑽 # Savian Letter Ear (listens)
  style: {
    stroke-width: 2
    stroke-dash: 2
  }
}
edge_call: {
  label: ☎ # calls
  style: {
    stroke-dash: 4
  }
}
edge_forward: {
  label: → # forwards
  style: {
    stroke-dash: 5
    stroke-width: 2
  }
}
