**.style.text-transform: none
_link: {
  height: 30
}
to_add: {
  style: {
    stroke-width: 3
  }
}
to_remove: {
  style: {
    stroke-width: 3
  }
}
unchanged: {
  style: {
    stroke-width: 3
  }
}
future: {
  style: {
    stroke-width: 3
    stroke-dash: 3
    fill: gray
  }
}
obj_proc: {
  style: {
    font-size: 16
  }
}
edge_spawn: {
  label: "forks/execs"
  style: {
    stroke-width: 1
  }
}
edge_signal: {
  label: "SIGINT"
  style: {
    stroke-width: 2
  }
}
edge_no_signal: {
  label: "SIGINT"
  style: {
    stroke-dash: 3
    stroke-width: 2
  }
}
TODO: give classes font-size above 25
cond: {
  shape: diamond
}
highlight: {
  style: {
    stroke-width: 5
    font-size: 24
    stroke: Crimson
    stroke-width: 4
  }
}
invis: {
  style: {
    stroke-width: 0
  }
}
ndx: { # TODO: reconsider shape
  shape: step
}
edge_down: {
  shape: oval
  label: ↓
  width: 25
  height: 35
}
positive: {
  shape: oval
}
negative: {
  shape: oval
}
iter: {
  width: 800
  height: 50
}
op: {
  shape: parallelogram
}
scalar: {
  style: {
    stroke-dash: 4
    stroke-width: 3
  }
}
data: {
  style: {
    stroke-dash: 3
    stroke-width: 3
  }
}
iter_step: {
  shape: circle
  style: {
    opacity: 1
    font-size: 22
  }
}
generic_node: { # not a well-named class; a placeholder for plain value/state nodes with no other class
  style: {
    font-size: 26
  }
}
generic_edge: { # not a well-named class; a placeholder for plain sequencing edges with no other class
  style: {
    font-size: 26
  }
}
gate_and: {
  shape: image
  icon: ./icons/gate_and.svg
}
gate_or: {
  shape: image
  icon: ./icons/gate_or.svg
}
gate_nand: {
  shape: image
  icon: ./icons/gate_nand.svg
}
gate_nor: {
  shape: image
  icon: ./icons/gate_nor.svg
}
gate_xor: {
  shape: image
  icon: ./icons/gate_xor.svg
}
gate_xnor: {
  shape: image
  icon: ./icons/gate_xnor.svg
}
gate_not: {
  shape: image
  icon: ./icons/gate_not.svg
}
