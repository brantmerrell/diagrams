# Aggregate of what used to be tech/classes/{basic,function,L4,L7,plan,
# process,sequence}.d2. Every diagram imports this one file with
# `classes: @"<rel>/classes"`; quality tags live separately in ./tags.d2.
#
# Class names are the contract with the frontend: d2 emits each class name
# as an SVG class attribute, and src/diagramSemanticThemes.css keys its
# light/dark colors off those names. Renaming a class here silently breaks
# its theming.
#
# Deliberately no `direction:` here. A `direction` key inside a
# `classes: @` import is parsed as a class named "direction", not as the
# diagram's layout direction, so it never had any effect. Set `direction`
# inside the layer that needs it instead.

**.style.text-transform: none

# ── basic ────────────────────────────────────────────────────────────────
_link: {
  height: 30
}

# ── plan ─────────────────────────────────────────────────────────────────
to_add: {
  style: {
    stroke-width: 3
  }
}
to_remove: {
  style: {
    stroke-width: 3
  }
}
unchanged: {
  style: {
    stroke-width: 3
  }
}
future: {
  style: {
    stroke-width: 3
    stroke-dash: 3
    fill: gray
  }
}

# ── process ──────────────────────────────────────────────────────────────
