    # Where sources disagree
    notes: {
      _note_shikhandi_amba: {
        grid-columns: 1
        text: |md
          **Shikhandi and Amba**\
          Shikhandi is Amba reborn in the majority of versions; the\
          cast list and his article also tell of a sex exchange with\
          a yaksha. The cast list credits the same actor as\
          "Sudama / Shikhandi".
        | {class: note; style.font-size: 16}
        _src0: {
          label: wiki/Shikhandi
          link: "https://en.wikipedia.org/wiki/Shikhandi"
          class: _link
        }
        _src1: {
          label: wiki/Amba_(Mahabharata)
          link: "https://en.wikipedia.org/wiki/Amba_(Mahabharata)"
          class: _link
        }
        _src2: {
          label: wiki/Mahabharat_(1988) # Recurring
          link: "https://en.wikipedia.org/wiki/Mahabharat_(1988_TV_series)#Recurring"
          class: _link
        }
      }
    }
    notes._note_shikhandi_amba -- _shikandi: {style: {stroke-dash: 3}}
