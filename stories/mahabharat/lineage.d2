    _hidimbi -- _union_bhima_hidimbi
    _union_bhima_hidimbi -> _ghatotkacha: {
      class: _character
    }

    # Panchala: Drupada and his children
    _drupada: {
      class: _character
      label: Drupada
      link: https://en.wikipedia.org/wiki/Drupada
    }
    _prishati: {
      class: _character_minor
      label: Prishati
      link: "https://en.wikipedia.org/wiki/List_of_characters_in_the_Mahabharata#Prishati"
    }
    _union_drupada_prishati: {
      class: _union_biological
    }
    _draupadi: {
      class: _character
      label: Draupadi
      link: https://en.wikipedia.org/wiki/Draupadi
    }
    _dhrishtadyumna: {
      class: _character
      label: Dhrishtadyumna
      link: https://en.wikipedia.org/wiki/Dhrishtadyumna
    }
    _shikandi: {
      class: _character
      label: Shikhandi
      link: https://en.wikipedia.org/wiki/Shikhandi
    }
    _amba: {
      class: _character
      label: Amba
      link: https://en.wikipedia.org/wiki/Amba_(Mahabharata)
    }
    _drupada -- _union_drupada_prishati
    _prishati -- _union_drupada_prishati
    _union_drupada_prishati -> _draupadi: {
      class: _character
    }
    _union_drupada_prishati -> _dhrishtadyumna: {
      class: _character
    }
    _union_drupada_prishati -> _shikandi: {
      class: _character
    }
    _amba -> _shikandi: reincarnation
    _union_draupadi_pandavas: {
      class: _union
    }
